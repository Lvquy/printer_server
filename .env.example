# Tên service systemd. Chỉ dùng chữ thường, số và dấu gạch ngang.
PRINT_APPLIANCE_SERVICE_NAME=print-appliance-secondary

# Địa chỉ LAN của Pi, dùng khi cài service lần đầu.
PRINT_APPLIANCE_HOST=192.168.0.123

# Cổng truy cập giao diện quản trị và API.
PRINT_APPLIANCE_PORT=8082

# Mật khẩu đăng nhập trang quản trị.
# Đổi giá trị này trước khi chạy script cài đặt.
PRINT_APPLIANCE_ADMIN_PASSWORD=CHANGE_THIS_TO_A_LONG_PASSWORD
